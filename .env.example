# Environment variables for PICON
# Copy this file to .env and fill in your values:  cp .env.example .env

# ── LLM API Keys ──
export GEMINI_API_KEY="your_gemini_api_key"
export GOOGLE_API_KEY="your_google_api_key"          # same as GEMINI_API_KEY if using Gemini
export OPENAI_API_KEY="your_openai_api_key"
export ANTHROPIC_API_KEY="your_anthropic_api_key"

# ── Search & Verification ──
export SERPER_API_KEY="your_serper_api_key"           # https://serper.dev (web search for external verification)
export GOOGLE_CLAIM_SEARCH="your_google_api_key"      # Google Custom Search API (fact checking)
export GOOGLE_CX_ID="your_custom_search_engine_id"    # Custom Search Engine ID
export GOOGLE_GEOCODE="your_google_geocode_api_key"   # Google Geocoding API (address validation)

# ── Persona Sources (optional) ──
export CAI_TOKEN="your_characterai_session_token"     # Character.AI session token (required for characterai.sh)
export CAI_API_KEY="your_characterai_api_key"         # Character.AI API key (alternative to CAI_TOKEN)

# ── Data (optional) ──
export HF_ORG_TOKEN="your_huggingface_token"          # HuggingFace token (for gated datasets)
export DATASET_DIR="/path/to/deeppersona"             # Local DeepPersona dataset directory (required for deeppersona.sh)
