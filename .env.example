# Environment variables for the Human Interview application
# Copy this file to .env and fill in your values

# OpenAI API Key (for GPT-5)
OPENAI_API_KEY=your_openai_api_key

# Google Claim Search API (for fact checking)
GOOGLE_CLAIM_SEARCH=your_google_api_key
GOOGLE_CX_ID=your_custom_search_engine_id

# Google Geocode API (for address validation)
GOOGLE_GEOCODE=your_google_geocode_api_key
